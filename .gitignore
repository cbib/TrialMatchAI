# ============================
# Benchmark + experiment outputs
# ============================
# Embedder benchmark measurements. The four series behind the README recall figure -- plus the
# registry that defines them -- stay TRACKED, because scripts/plot_embedder_recall.py rebuilds
# that figure from them and a published claim should be reproducible from a clean clone.
# Every other run in here is exploratory: kept on disk, out of git.
benchmarks/embedders/*.json
!benchmarks/embedders/registry.json
!benchmarks/embedders/bge-m3-vw0.6.json
!benchmarks/embedders/qwen3-0.6b-vw0.6.json
!benchmarks/embedders/medcpt-vw0.6.json
!benchmarks/embedders/pubmedbert-neuml-vw0.6.json

# Per-run analysis dumps written to the repo root by scripts/ (candidate-id dumps, sweep
# results, expansion samples). Measurements of one particular run, often megabytes, and
# regenerated by re-running the script.
/*_sweep_*.json
/*_samples.json

# Experiment result trees -- one directory per run/arm, written to the repo root by the SLURM
# job scripts and named after the hardware/model/ablation of the run. The set grows with every
# experiment, so these root-anchored patterns cover the families instead of listing each one.
/*_ab/
/*_ab_*/
/h100_*/
/l40_*/
/a40_*/
/*_medcpt/
/*_medcpt_*/
/trec2[0-9]_*/
/data_medcpt/
/huatuo_*/
/iimedical_*/
/qwen*/
/baichuan*/

# Editor settings
.vscode/
